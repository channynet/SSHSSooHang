from base import Entity, Behavior

class DungBeetle(Entity):
    def __init__(self):
        self.is_rolling = False
        self.ball_size = 0

        self.fullness = 100 

    def behaviors(self) -> list["Behavior"]:
        return [RollDung(), EatDung()]

    def start_rolling(self):
        self.is_rolling = True
        self.ball_size += 1 # 굴릴수록 커짐

    def eat_dung(self):
        self.fullness += 20
        self.is_rolling = False
        self.ball_size = 0
        print("쇠똥구리가 배설물을 완전히 처리했습니다.")

    def move(self): pass
    def produce_dung(self): pass
