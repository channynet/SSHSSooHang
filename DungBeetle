class RollDung(Behavior):
    def determine(self, entity: "DungBeetle", env: "Env") -> bool:
        return env.has_dung_nearby(entity) and not entity.is_rolling

    def act(self, entity: "DungBeetle", env: "Env"):
        entity.start_rolling()
        print(f"쇠똥구리가 배설물을 발견하여 공을 굴리기 시작합니다!")

class EatDung(Behavior):
    def determine(self, entity: "DungBeetle", env: "Env") -> bool:
        return entity.is_rolling and entity.ball_size >= 10

    def act(self, entity: "DungBeetle", env: "Env"):
        entity.eat_dung()
        print("공 크기가 충분하여 쇠똥구리가 섭취합니다.")

